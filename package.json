{
  "name": "kdenlive-mcp",
  "version": "1.1.1",
  "private": true,
  "description": "Headless, MLT-backed video editing foundation for MCP clients",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felixkarevo/kdenlive-mcp.git"
  },
  "homepage": "https://github.com/felixkarevo/kdenlive-mcp#readme",
  "bugs": "https://github.com/felixkarevo/kdenlive-mcp/issues",
  "keywords": [
    "mcp",
    "kdenlive",
    "mlt",
    "video-editing",
    "ffmpeg"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:runtime": "vitest run packages/project-core/src/media.runtime.test.ts",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b --pretty false",
    "check": "bun run format:check && bun run typecheck && bun run lint && bun run test",
    "capabilities": "bun run --cwd packages/runtime-probe probe",
    "spike:prepare": "bun run --cwd packages/mlt-spike prepare-fixtures",
    "spike:compile": "bun run --cwd packages/mlt-spike compile",
    "spike:render": "bun run --cwd packages/mlt-spike render",
    "render:acceptance": "bun run build && bun run --cwd packages/render-core acceptance",
    "mcp:start": "bun run build && bun run --cwd apps/mcp-server start",
    "mcp:acceptance": "bun run build && bun run --cwd apps/mcp-server acceptance",
    "sample:milestone-6": "bun run build && node scripts/create-milestone-6-sample.mjs",
    "doctor": "bun run build && node apps/mcp-server/dist/cli.js --doctor",
    "docs:check": "node scripts/verify-docs.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "effects:generate": "node scripts/generate-kdenlive-effect-catalog.mjs && prettier --write packages/project-core/src/kdenlive-effects.generated.ts",
    "licenses:report": "node scripts/generate-notices.mjs",
    "package:release": "bun run build && bun run licenses:report && node scripts/package-release.mjs",
    "package:archive": "bun run build && node scripts/package-release.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "release:acceptance": "node scripts/release-acceptance.mjs",
    "fixtures:milestone-1": "bun run --cwd packages/project-core fixtures",
    "worker:check": "python -m pytest apps/analysis-worker && python -m mypy apps/analysis-worker/src"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.0.0",
    "fast-check": "^4.8.0",
    "prettier": "^3.5.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.1.9"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
